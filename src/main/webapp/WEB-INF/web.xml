<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
	<display-name>Learn JPA</display-name>

	<!-- Đọc/ghi tiếng Việt UTF-8 cho mọi request/response -->
	<request-character-encoding>UTF-8</request-character-encoding>
	<response-character-encoding>UTF-8</response-character-encoding>

	<!-- SiteMesh 3: bọc layout chung (WEB-INF/decorators/*.jsp) quanh các trang, cấu hình ở WEB-INF/sitemesh3.xml -->
	<filter>
		<filter-name>sitemesh</filter-name>
		<filter-class>org.sitemesh.config.ConfigurableSiteMeshFilter</filter-class>
	</filter>
	<!-- Tomcat 11 đóng response ngay sau forward, nên SiteMesh phải bọc layout bên trong forward
	     (servlet -> forward -> views/*.jsp). Trang .jsp gọi trực tiếp (index.jsp) dùng REQUEST. -->
	<filter-mapping>
		<filter-name>sitemesh</filter-name>
		<url-pattern>/*</url-pattern>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>
	<filter-mapping>
		<filter-name>sitemesh</filter-name>
		<url-pattern>*.jsp</url-pattern>
		<dispatcher>REQUEST</dispatcher>
	</filter-mapping>

	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<session-config>
		<session-timeout>30</session-timeout>
		<tracking-mode>COOKIE</tracking-mode>
	</session-config>
</web-app>
